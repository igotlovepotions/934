Clear
Set DefaultBaseFrequency=60
Set DataPath=C:\Users\amy\projects\opendss\trab

Redirect ieee37.dss
!Redirect pvsystem.dss
!Solve Loadmult=0.5
Set Loadmult=0.2

Set VoltageBases = "230,4.8,0.48"
CalcVoltageBases
BusCoords IEEE37_BusXY.csv

new monitor.line_nopv_loadmult_L1_potencia element=Line.L1 terminal=1 mode=1
new monitor.line_nopv_loadmult_L1_VI element=Line.L1 terminal=1 mode=0

Set DataPath=C:\Users\amy\projects\opendss\trab\resultados\nopv_loadmult


!set mode=daily
!set number=24
!Set Stepsize=1h

!set DemandInterval=true
!set overloadreport=true
!set voltexceptionreport=true
!set DIVerbose=true
solve
!closeDI

Set mode=snap
Solve
Sample

Export Voltages nopv_loadmult_voltages.csv
Export Overloads nopv_loadmult_overloads.csv
Export monitors all
!Export monitor line_nopv_loadmult_L1_potencia
!Export monitor line_nopv_loadmult_L1_VI
